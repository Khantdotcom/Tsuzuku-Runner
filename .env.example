# Copy to .env for local development. Taskfile loads .env automatically.
# `docker compose up` needs no .env: it wires service addresses itself and only
# reads TSUZUKU_WORKER_TOKEN, TSUZUKU_LOG_LEVEL, and the TSUZUKU_*_HOST_PORT values from here.

# development | test | production (development logs as text, others as JSON)
TSUZUKU_ENV=development
# debug | info | warn | error
TSUZUKU_LOG_LEVEL=debug

# Database (server, migrate, seed). Workers never connect to the database.
# Matches the compose.yaml Postgres; change the port if you set TSUZUKU_PG_HOST_PORT.
TSUZUKU_DATABASE_URL=postgres://tsuzuku:tsuzuku@127.0.0.1:5433/tsuzuku?sslmode=disable
# Host port for the compose Postgres (5433 avoids a local Postgres on 5432)
TSUZUKU_PG_HOST_PORT=5433
# Host ports for the compose API server and dashboard
TSUZUKU_API_HOST_PORT=8080
TSUZUKU_UI_HOST_PORT=3000

# Shared secret workers send as a bearer token (server and worker).
# Production requires at least 32 characters, e.g. `openssl rand -hex 32`.
TSUZUKU_WORKER_TOKEN=dev-worker-token

# Server
TSUZUKU_HTTP_ADDR=:8080
TSUZUKU_SHUTDOWN_TIMEOUT=10s
# A worker is reported offline when its last heartbeat is older than this.
TSUZUKU_WORKER_STALE_AFTER=15s
# Time between scheduling rounds that place QUEUED jobs on workers (at least 100ms).
TSUZUKU_SCHEDULER_INTERVAL=1s
# How long a claimed attempt stays owned without a renewing heartbeat (at least 1s).
TSUZUKU_LEASE_TTL=30s
# Retryable failures may use this many attempts; wait base then doubles up to cap.
TSUZUKU_JOB_MAX_ATTEMPTS=3
TSUZUKU_RETRY_BACKOFF_BASE=1s
TSUZUKU_RETRY_BACKOFF_CAP=5m
# The most a single workload may request (1000 millicores = 1 CPU core).
TSUZUKU_WORKLOAD_MAX_CPU_MILLIS=4000
TSUZUKU_WORKLOAD_MAX_MEMORY_MB=8192
TSUZUKU_WORKLOAD_MAX_TIMEOUT=1h
# Where job evidence files (stdout.log, stderr.log) are stored. The compose
# server uses a named volume at /var/lib/tsuzuku/artifacts instead.
TSUZUKU_ARTIFACT_DIR=./data/artifacts
# Most output one attempt may store (bytes, at least 65536); the rest is dropped.
TSUZUKU_MAX_LOG_BYTES=10485760

# Worker (name defaults to the host name). Use a name the compose workers
# (worker-01, worker-02) don't, or both processes will share one registration.
TSUZUKU_WORKER_NAME=host-worker
# API base URL for the worker process, and for the Next.js dashboard proxy
# (also set TSUZUKU_API_URL in the Vercel project when deploying frontend/).
TSUZUKU_API_URL=http://localhost:8080
TSUZUKU_WORKER_SLOTS=2
TSUZUKU_WORKER_HEARTBEAT_INTERVAL=5s
# Workers run jobs through the Docker daemon named by DOCKER_HOST (default: the
# local socket) and exit at startup if it is unreachable.
# Helper image that clones repositories, and how long a clone may take.
TSUZUKU_WORKER_GIT_IMAGE=alpine/git:v2.49.1
TSUZUKU_WORKER_CHECKOUT_TIMEOUT=5m
# Optional AI executor (executor.kind=ai workloads). Off by default.
TSUZUKU_AI_EXECUTOR_ENABLED=false
# TSUZUKU_AI_EXECUTOR_COMMAND=agent run --prompt {{printf "%q" .Prompt}}

# Optional GitHub PR delivery (workloads with delivery.github_pr=true).
# TSUZUKU_GITHUB_TOKEN=
# TSUZUKU_GITHUB_API_BASE=https://api.github.com
