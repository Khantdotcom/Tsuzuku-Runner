# Copy to .env for local development. Taskfile loads .env automatically.

# development | test | production (development logs as text, others as JSON)
TSUZUKU_ENV=development
# debug | info | warn | error
TSUZUKU_LOG_LEVEL=debug

# Server
TSUZUKU_HTTP_ADDR=:8080
TSUZUKU_SHUTDOWN_TIMEOUT=10s

# Worker (name defaults to the host name)
TSUZUKU_WORKER_NAME=worker-01
TSUZUKU_WORKER_HEARTBEAT_INTERVAL=5s
